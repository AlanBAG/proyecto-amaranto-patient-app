<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso necesario para conectarse al backend en Laravel mediante Retrofit -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Amaranto">

        <!-- Pantalla de Inicio de Sesión (Lanzador principal de la app) -->
        <activity
            android:name=".views.LoginActivity"
            android:exported="true"
            android:label="@string/login_title"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Registro de Pacientes -->
        <activity
            android:name=".views.RegisterActivity"
            android:exported="false"
            android:label="@string/register_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de Expediente Clínico (SOLO LECTURA) -->
        <activity
            android:name=".views.ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>
